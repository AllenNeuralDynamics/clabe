  "info": {
    "description": "Follow a fleet of rigs: what each runs, which ones wait for an answer, and each rig's own API under /rigs/<id>/.",
    "title": "clabe hub API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/hub/inbox": {
      "get": {
        "description": "The rigs whose run waits for an answer, longest-waiting first.",
        "operationId": "inbox_api_hub_inbox_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RigStatus"
                  },
                  "title": "Response Inbox Api Hub Inbox Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Inbox"
      }
    },
    "/api/hub/inspect": {
      "post": {
        "description": "Opens an export (or a report's zip) for a look, without storing it; kept for an hour after last use.",
        "operationId": "inspect_api_hub_inspect_post",
        "requestBody": {
          "content": {
            "application/zip": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "description": "The zip: the raw body, or a multipart form's ``file``",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectResult"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Inspect"
      }
    },
    "/api/hub/inspect/{inspect_id}/files/{path}": {
      "get": {
        "description": "A file of an opened export, as text; 413 beyond 20 MB.",
        "operationId": "inspect_file_api_hub_inspect__inspect_id__files__path__get",
        "parameters": [
          {
            "description": "The id the upload was given",
            "in": "path",
            "name": "inspect_id",
            "required": true,
            "schema": {
              "description": "The id the upload was given",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Inspect Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The file's text (UTF-8)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inspect File"
      }
    },
    "/api/hub/refresh": {
      "post": {
        "description": "Polls every rig now (and collects their reports).",
        "operationId": "refresh_api_hub_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RigStatus"
                  },
                  "title": "Response Refresh Api Hub Refresh Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Refresh"
      }
    },
    "/api/hub/reports": {
      "get": {
        "description": "The collected reports matching the filters, sorted, a page at a time (``total`` counts every match).",
        "operationId": "reports_api_hub_reports_get",
        "parameters": [
          {
            "description": "Only from this rig",
            "in": "query",
