@* A stroke icon (Lucide-like) for the run page, inheriting the text color. Decorative: label what holds it. *@

<svg class="ri @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />
            break;
        case "x":
            <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            break;
        case "x-circle":
            <circle cx="12" cy="12" r="9" /><path d="m15 9-6 6" /><path d="m9 9 6 6" />
            break;
        case "circle":
            <circle cx="12" cy="12" r="8" />
            break;
        case "dot":
            <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none" />
            break;
        case "skip":
            <circle cx="12" cy="12" r="8" stroke-dasharray="3 3" /><path d="M8.5 12h7" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;
        case "left":
            <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
            break;
        case "right":
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            break;
        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "undo":
            <path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
            break;
        case "retry":
            <path d="M21 12a9 9 0 1 1-2.64-6.36" /><path d="M21 3v6h-6" />
            break;
        case "external":
            <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            break;
        case "expand":
            <path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" />
            break;
        case "download":
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
            break;
        case "flag":
            <path d="M4 22V4" /><path d="M4 4h12l-2 4 2 4H4" />
            break;
        case "keyboard":
            <rect x="2" y="6" width="20" height="12" rx="2" /><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10" />
            break;
        case "book":
            <path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6.5A2.5 2.5 0 0 0 4 21.5" /><path d="M20 19v3H6.5" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 16v-4" /><path d="M12 8h.01" />
            break;
        case "alert":
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4" /><path d="M12 17h.01" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            break;
        case "monitor":
            <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            break;
        case "folder":
            <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
            break;
        case "file":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" />
            break;
        case "folder-up":
            <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9l-.8-1.2A2 2 0 0 0 7.9 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" /><path d="M12 10v6" /><path d="m9 13 3-3 3 3" />
            break;
        case "terminal":
            <path d="m4 17 6-6-6-6" /><path d="M12 19h8" />
            break;
        case "list":
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "stop":
            <circle cx="12" cy="12" r="9" /><rect x="9" y="9" width="6" height="6" rx="1" />
            break;
        case "power":
            <path d="M12 2v10" /><path d="M18.4 6.6a9 9 0 1 1-12.8 0" />
            break;
        case "server":
            <rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" /><path d="M7 7.5h.01M7 16.5h.01" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "message":
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            break;
        default:
            <circle cx="12" cy="12" r="2" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public double Stroke { get; set; } = 2;
    [Parameter] public string? Class { get; set; }
}
