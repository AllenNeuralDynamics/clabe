@* The top bar of the hub's and the daemon's pages: the brand and where you are, status chips, actions, settings. *@
@inject RunApi Api

<header class="topbar">
    <a class="brand" href="@(Home ?? Api.HomeUrl)" title="Home" aria-label="clabe @Context: home">
        <img src="logo.svg" alt="" />
        <span class="where">@Context</span>
        @if (Version is { Length: > 0 })
        {
            <span class="version" title="clabe version">v@(Version)</span>
        }
    </a>
    @if (Chips is not null)
    {
        <div class="chips">@Chips</div>
    }
    <span class="grow"></span>
    @Actions
    <div class="settings-menu">
        <button type="button" class="ghost icon" aria-label="Settings" title="Settings (theme, times)"
                aria-haspopup="@(OnSettings.HasDelegate ? null : "dialog")" aria-expanded="@(OnSettings.HasDelegate ? null : _open ? "true" : "false")"
                @onclick="OpenSettings">
            <HubIcon Name="settings" />
        </button>
        @if (_open)
        {
            <div class="scrim" @onclick="() => _open = false"></div>
            <div class="popover" role="dialog" aria-label="Settings" @onkeydown="OnKey">
                <SettingsPanel Compact="true" />
            </div>
        }
    </div>
</header>

@code {
    /// <summary>Where you are: "hub", a rig…</summary>
    [Parameter] public string Context { get; set; } = "";
    /// <summary>The clabe version of what serves the page, shown next to it (once known).</summary>
    [Parameter] public string? Version { get; set; }
    /// <summary>Where the brand links; by default the home page (the hub's, from a rig's page).</summary>
    [Parameter] public string? Home { get; set; }
    [Parameter] public RenderFragment? Chips { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>Opens the page's own settings (the hub's Settings tab); without it, the gear opens them in a popover.</summary>
    [Parameter] public EventCallback OnSettings { get; set; }

    private bool _open;

    private async Task OpenSettings()
    {
        if (OnSettings.HasDelegate)
        {
            await OnSettings.InvokeAsync();
            return;
        }
        _open = !_open;
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }
}
