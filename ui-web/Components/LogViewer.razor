@* A log (or any text): monospace numbered lines colored by level (ERROR, WARNING, DEBUG), searchable (matches
   marked, Enter / Shift+Enter to the next / previous one, optionally only the matching lines), virtualized. *@
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="lv">
    <div class="lv-bar">
        <ReportSearchBox Value="@_query" ValueChanged="Search" Placeholder="Search this file" Navigable="true"
                         Count="_total" Current="_current" OnNext="() => Move(1)" OnPrevious="() => Move(-1)" />
        <label class="only">
            <input type="checkbox" checked="@_onlyMatches" @onchange="ToggleOnly" />
            Matching lines only
        </label>
        <span class="grow"></span>
        <span class="levels">
            @if (_errors > 0)
            {
                <span class="chip failed">@_errors error@(_errors == 1 ? "" : "s")</span>
            }
            @if (_warnings > 0)
            {
                <span class="chip waiting no-pulse">@_warnings warning@(_warnings == 1 ? "" : "s")</span>
            }
            <span class="subtle tiny">@_lines.Length.ToString("N0") lines</span>
        </span>
    </div>
    <div class="lv-body" @ref="_body" tabindex="0" aria-label="File content">
        <div class="rows">
            <Virtualize Items="_visible" ItemSize="RowHeight" OverscanCount="20" Context="index" @ref="_virtualize">
                <div class="row @Level(index)" @key="index">
                    <span class="ln" aria-hidden="true">@(index + 1)</span>
                    <span class="tx">@ReportSearch.Marked(_lines[index], null, _query, Start(index), _current)</span>
                </div>
            </Virtualize>
        </div>
        @if (_visible.Count == 0)
        {
            <p class="empty subtle">@(_lines.Length <= 1 && _lines.FirstOrDefault() is "" ? "This file is empty." : "No line matches.")</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    private const int RowHeight = 20;
    private static readonly Regex ErrorPattern = new(@"\b(ERROR|CRITICAL|FATAL|Traceback|Exception)\b", RegexOptions.Compiled);
    private static readonly Regex WarningPattern = new(@"\b(WARNING|WARN)\b", RegexOptions.Compiled);
    private static readonly Regex DebugPattern = new(@"\b(DEBUG|TRACE)\b", RegexOptions.Compiled);

    private string? _text;
    private string[] _lines = [];
    private byte[] _levels = [];
    private int _errors, _warnings;
    private List<int> _visible = [];
    private string? _query;
    private int[] _start = [];
    private int[] _matchLine = [];
    private int _total;
    private int _current = -1;
    private bool _onlyMatches;
    private int? _scrollTo;
    private ElementReference _body;
    private Virtualize<int>? _virtualize;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (Text == _text)
        {
            return;
        }
        _text = Text;
        _lines = Text.TrimEnd('\n').Replace("\r\n", "\n").Split('\n');
        _levels = new byte[_lines.Length];
        _errors = _warnings = 0;
        for (var i = 0; i < _lines.Length; i++)
        {
            var line = _lines[i];
            _levels[i] = ErrorPattern.IsMatch(line) ? (byte)3 : WarningPattern.IsMatch(line) ? (byte)2 : DebugPattern.IsMatch(line) ? (byte)1 : (byte)0;
            if (_levels[i] == 3)
            {
                _errors++;
            }
            else if (_levels[i] == 2)
            {
                _warnings++;
            }
        }
        Recount();
    }

    private string Level(int index) => _levels[index] switch
    {
        3 => "level-error",
        2 => "level-warning",
        1 => "level-debug",
        _ => "",
    };

    private int Start(int index) => _start.Length > index ? _start[index] : 0;

    private void Recount()
    {
        _total = 0;
        _current = -1;
        if (string.IsNullOrEmpty(_query))
        {
            _start = [];
            _matchLine = [];
            _visible = Enumerable.Range(0, _lines.Length).ToList();
            return;
        }
        _start = new int[_lines.Length];
        var matchLine = new List<int>();
        var visible = new List<int>();
        for (var i = 0; i < _lines.Length; i++)
        {
            _start[i] = _total;
            var count = ReportSearch.Count(_lines[i], _query);
            for (var k = 0; k < count; k++)
            {
                matchLine.Add(i);
            }
            _total += count;
            if (!_onlyMatches || count > 0)
            {
                visible.Add(i);
            }
        }
        _matchLine = [.. matchLine];
        _visible = visible;
    }

    private void Search(string query)
    {
        _query = query;
        Recount();
        if (_total > 0)
        {
            Show(0);
        }
    }

    private void ToggleOnly(ChangeEventArgs e)
    {
        _onlyMatches = e.Value is true;
        var current = _current;
        Recount();
        if (current >= 0 && current < _total)
        {
            Show(current);
        }
    }

    private void Move(int step)
    {
        if (_total > 0)
        {
            Show(((_current + step) % _total + _total) % _total);
        }
    }

    private void Show(int ordinal)
    {
        _current = ordinal;
        var position = _visible.BinarySearch(_matchLine[ordinal]);
        _scrollTo = position >= 0 ? position : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTo is { } row)
        {
            _scrollTo = null;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/report.js");
            await _module.InvokeVoidAsync("scrollToRow", _body, row, RowHeight, 8);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
