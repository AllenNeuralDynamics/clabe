@* The theme: light, dark, or as the system says (kept in the browser by ui.js). *@
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="theme">
    <button type="button" class="ghost icon" aria-label="Theme" aria-haspopup="menu" aria-expanded="@_open" title="Theme"
            @onclick="() => _open = !_open">
        <HubIcon Name="@(_choice == "dark" ? "moon" : _choice == "light" ? "sun" : "monitor")" />
    </button>
    @if (_open)
    {
        <div class="scrim" @onclick="() => _open = false"></div>
        <div class="popover" role="menu" aria-label="Theme" @onkeydown="OnKey">
            @for (var i = 0; i < Choices.Length; i++)
            {
                var index = i;
                var (value, label, icon) = Choices[index];
                <button type="button" role="menuitemradio" aria-checked="@(_choice == value)" class="menu-item @(_choice == value ? "active" : "")"
                        @onclick="() => Apply(value)" @ref="_items[index]">
                    <span class="label"><HubIcon Name="@icon" Size="14" /> @label</span>
                    @if (_choice == value)
                    {
                        <HubIcon Name="check" Size="14" />
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Value, string Label, string Icon)[] Choices =
        [("light", "Light", "sun"), ("dark", "Dark", "moon"), ("system", "System", "monitor")];

    private readonly ElementReference[] _items = new ElementReference[Choices.Length];
    private IJSObjectReference? _ui;
    private string _choice = "system";
    private bool _open;
    private bool _focus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ui = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
            _choice = await _ui.InvokeAsync<string>("applyTheme", (string?)null);
            StateHasChanged();
        }
        if (_open && !_focus)
        {
            _focus = true;
            await _items[Math.Max(0, Array.FindIndex(Choices, c => c.Value == _choice))].FocusAsync();
        }
        if (!_open)
        {
            _focus = false;
        }
    }

    private async Task Apply(string value)
    {
        _choice = value;
        _open = false;
        if (_ui is not null)
        {
            await _ui.InvokeAsync<string>("applyTheme", value);
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        var at = Array.FindIndex(Choices, c => c.Value == _choice);
        switch (e.Key)
        {
            case "Escape":
                _open = false;
                break;
            case "ArrowDown" or "ArrowUp":
                // move the focus; Enter (on the focused item) applies it
                var focused = e.Key == "ArrowDown" ? 1 : -1;
                _cursor = ((_cursor < 0 ? at : _cursor) + focused + Choices.Length) % Choices.Length;
                await _items[_cursor].FocusAsync();
                break;
        }
    }

    private int _cursor = -1;

    public async ValueTask DisposeAsync()
    {
        if (_ui is not null)
        {
            try
            {
                await _ui.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
