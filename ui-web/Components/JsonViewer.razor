@* JSON, pretty-printed and highlighted, its objects and arrays foldable; with a toolbar, searchable (matches
   marked, Enter / Shift+Enter to the next / previous one, folded matches unfolded on the way). *@
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="jv @(Fill ? "fill" : "") @(Toolbar ? "" : "bare")">
    @if (Toolbar)
    {
        <div class="jv-bar">
            <ReportSearchBox Value="@_query" ValueChanged="Search" Placeholder="Search this file" Navigable="true"
                             Count="_total" Current="_current" OnNext="() => Move(1)" OnPrevious="() => Move(-1)" />
            <span class="grow"></span>
            @if (_lines is not null && _lines.Any(l => l.Opens))
            {
                <button type="button" class="ghost sm" @onclick="FoldAll" title="Fold everything below the top level"><HubIcon Name="fold" Size="14" /> Fold</button>
                <button type="button" class="ghost sm" @onclick="UnfoldAll" title="Unfold everything"><HubIcon Name="unfold" Size="14" /> Unfold</button>
            }
        </div>
    }
    <div class="jv-body" @ref="_body">
        @if (_lines is null)
        {
            <pre class="raw">@Text</pre>
        }
        else
        {
            <div class="lines" role="tree" aria-label="JSON">
                @for (var i = 0; i < _lines.Count;)
                {
                    var index = i;
                    var line = _lines[index];
                    var folded = line.Opens && _folded.Contains(index);
                    var ordinal = _lineStart.Length > index ? _lineStart[index] : 0;
                    <div class="jl @(folded ? "folded" : "")" @key="index">
                        @if (Numbers)
                        {
                            <span class="ln" aria-hidden="true">@(index + 1)</span>
                        }
                        <span class="tx" style="padding-left: calc(@(line.Depth) * 2ch + 18px)">
                            @if (line.Opens)
                            {
                                <button type="button" class="tg" aria-expanded="@(!folded)" aria-label="@(folded ? "Unfold" : "Fold")"
                                        @onclick="() => Toggle(index)" style="left: calc(@(line.Depth) * 2ch)">
                                    <HubIcon Name="@(folded ? "right" : "down")" Size="12" />
                                </button>
                            }
                            @foreach (var token in line.Tokens)
                            {
                                @ReportSearch.Marked(token.Text, token.Class, _query, ordinal, _current)
                                ordinal += ReportSearch.Count(token.Text, _query);
                            }
                            @if (folded)
                            {
                                <button type="button" class="more" @onclick="() => Toggle(index)">@line.Summary</button><span class="tok-punct">@line.Close</span>
                            }
                        </span>
                    </div>
                    i = folded ? line.End + 1 : index + 1;
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    /// <summary>Shows the search and fold toolbar.</summary>
    [Parameter] public bool Toolbar { get; set; } = true;
    /// <summary>Fills its container, scrolling inside.</summary>
    [Parameter] public bool Fill { get; set; }
    [Parameter] public bool Numbers { get; set; } = true;
    /// <summary>A query to mark, when the search is outside (no toolbar).</summary>
    [Parameter] public string? Query { get; set; }

    private string? _text;
    private List<JsonLine>? _lines;
    private readonly HashSet<int> _folded = [];
    private string? _query;
    private int[] _lineStart = [];
    private int _total;
    private int _current = -1;
    private bool _reveal;
    private ElementReference _body;
    private IJSObjectReference? _module;

    /// <summary>Above this many lines, everything below the second level starts folded.</summary>
    private const int FoldAbove = 1500;

    protected override void OnParametersSet()
    {
        if (Text != _text)
        {
            _text = Text;
            _lines = JsonPretty.TryLines(Text);
            _folded.Clear();
            if (_lines is { Count: > FoldAbove })
            {
                for (var i = 0; i < _lines.Count; i++)
                {
                    if (_lines[i].Opens && _lines[i].Depth >= 2)
                    {
                        _folded.Add(i);
                    }
                }
            }
            Recount();
        }
        if (!Toolbar && Query != _query)
        {
            _query = Query;
            Recount();
        }
    }

    private void Search(string query)
    {
        _query = query;
        Recount();
        if (_total > 0)
        {
            Show(0);
        }
    }

    private void Recount()
    {
        _total = 0;
        _current = -1;
        if (_lines is null || string.IsNullOrEmpty(_query))
        {
            _lineStart = [];
            return;
        }
        _lineStart = new int[_lines.Count];
        for (var i = 0; i < _lines.Count; i++)
        {
            _lineStart[i] = _total;
            foreach (var token in _lines[i].Tokens)
            {
                _total += ReportSearch.Count(token.Text, _query);
            }
        }
    }

    private void Move(int step)
    {
        if (_total == 0)
        {
            return;
        }
        Show(((_current + step) % _total + _total) % _total);
    }

    /// <summary>Makes match <paramref name="ordinal"/> current: unfolds what hides it and scrolls to it.</summary>
    private void Show(int ordinal)
    {
        _current = ordinal;
        var line = Array.FindLastIndex(_lineStart, start => start <= ordinal);
        for (var parent = line >= 0 ? _lines![line].Parent : -1; parent >= 0; parent = _lines![parent].Parent)
        {
            _folded.Remove(parent);
        }
        _reveal = true;
    }

    private void Toggle(int index)
    {
        if (!_folded.Remove(index))
        {
            _folded.Add(index);
        }
    }

    private void FoldAll()
    {
        _folded.Clear();
        for (var i = 0; i < _lines!.Count; i++)
        {
            if (_lines[i].Opens && _lines[i].Depth >= 1)
            {
                _folded.Add(i);
            }
        }
    }

    private void UnfoldAll() => _folded.Clear();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reveal)
        {
            _reveal = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/report.js");
            await _module.InvokeVoidAsync("revealIn", _body, ".search-hit.current");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
