@* The run's steps. A finished step that is not locked behind a barrier can be clicked to go back to it. *@

<nav class="stepper">
    <ol>
        @foreach (var step in State.Steps)
        {
            var current = step.Name == State.CurrentStep;
            var canGoBack = !Finished && !step.Locked && !current && step.Status is "done" or "skipped" or "failed";
            <li class="@step.Status @(current ? "current" : null)" title="@StepTooltip(step, canGoBack)">
                <span class="icon">@Icon(step, current)</span>
                @if (canGoBack)
                {
                    <button type="button" class="link" @onclick="() => OnGoBack.InvokeAsync(step.Name)">@step.Title</button>
                    <span class="back" aria-hidden="true">↶</span>
                }
                else
                {
                    <span class="title">@step.Title</span>
                }
                @if (step.Optional is not null)
                {
                    <span class="tag">optional</span>
                }
                @if (step.Conditional)
                {
                    <span class="tag" title="Runs only when its condition holds">conditional</span>
                }
                @if (step.Locked)
                {
                    <span class="lock" title="Locked: a later barrier step has run">🔒</span>
                }
                @if (step.Summary is { } summary)
                {
                    <small title="@summary">@summary</small>
                }
                @if (Branches?.Invoke(step.Name) is { Count: > 0 } branches)
                {
                    <ul class="branches">
                        @foreach (var branch in branches)
                        {
                            <li class="@branch.Status" title="@(branch.Error ?? branch.Status)">
                                <span class="icon">@BranchIcon(branch.Status)</span> @branch.Name
                                @if (branch.Attempt > 1)
                                {
                                    <span class="tag">attempt @branch.Attempt</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired] public RunState State { get; set; } = default!;
    [Parameter] public bool Finished { get; set; }
    [Parameter] public EventCallback<string> OnGoBack { get; set; }
    [Parameter] public Func<string, IReadOnlyList<BranchView>>? Branches { get; set; }

    private static string BranchIcon(string status) => status switch
    {
        "running" => "◌",
        "done" => "✓",
        "failed" => "✕",
        "skipped" => "–",
        _ => "■",
    };

    private static string Icon(StepState step, bool current) => step.Status switch
    {
        "done" => "✓",
        "skipped" => "–",
        "failed" => "✕",
        "running" => "●",
        _ => current ? "●" : "○",
    };

    private static string StepTooltip(StepState step, bool canGoBack)
    {
        var skipped = step.SkipReason switch
        {
            "condition" => "Skipped: its condition did not hold. ",
            "declined" => "Skipped: declined. ",
            _ => "",
        };
        return skipped + (canGoBack ? $"Go back to {step.Title}: it and the steps depending on it run again" : step.Name);
    }
}
