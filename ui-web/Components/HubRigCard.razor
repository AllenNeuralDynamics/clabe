@* A rig in the fleet: its status, what it runs, its reports, its token, a way to its page, and restarting its
   daemon (through its API, or over SSH when it does not answer). *@
@inject HubApi Hub
@inject RigCredentials Credentials

<article class="rig card @(Rig.Reachable ? "" : "offline") @(Rig.Waiting is not null ? "waiting" : "")" aria-label="@Rig.Id">
    <header>
        <div class="who">
            <span class="ic"><HubIcon Name="server" Size="15" /></span>
            <div class="names">
                @* The rig's AIBS_RIG_ID first; "----" when the rig does not set it (or runs an older clabe). *@
                <h3 class="truncate @(Rig.RigId is null ? "unset" : null)" title="AIBS_RIG_ID">@(Rig.RigId ?? "----")</h3>
                <span class="host subtle truncate" title="@HostLine(Rig)">@HostLine(Rig)</span>
            </div>
        </div>
        @{ var chip = StatusChip(Rig); }
        <span class="chip @chip.Css">@chip.Text</span>
    </header>

    <div class="rig-body">
        @if (Rig.MovedFrom is { } movedFrom)
        {
            <div class="moved small">
                <p>Enrolled from <code>@Host(Rig.Url)</code>, was <code>@Host(movedFrom)</code>. The hub holds it, without its token, until you confirm the move. Confirm only if this rig really moved.</p>
                <button type="button" class="sm primary" disabled="@_confirming" @onclick="Confirm">Confirm move</button>
            </div>
        }
        else if (Rig.NeedsToken)
        {
            <p class="line small needs-token">It refuses the hub's token. Enter this rig's token with <strong>Token</strong> below.</p>
        }
        else if (!Rig.Reachable)
        {
            <p class="line subtle small unreachable" title="@Rig.Error">Not reachable: @(Rig.Error ?? "no answer")</p>
        }
        else if (Rig.Status == "busy" || Rig.Experiment is not null)
        {
            <div class="line">
                <span class="k">Experiment</span>
                <span class="v truncate">@(Rig.Experiment ?? "—")</span>
            </div>
            <div class="line">
                <span class="k">Step</span>
                <span class="v truncate">@(Rig.CurrentStepTitle ?? Rig.CurrentStep ?? "—")</span>
            </div>
            @if (Rig.Waiting is { } waiting)
            {
                <div class="ask">
                    <HubIcon Name="message" Size="13" />
                    <span class="truncate">@waiting.Label</span>
                    <span class="since">@ReportTime.Duration(DateTimeOffset.UtcNow - waiting.Since)</span>
                </div>
            }
        }
        else if (Rig.LeasedBy is { } owner)
        {
            <p class="line subtle small">In use by <strong>@owner</strong></p>
        }
        else
        {
            <p class="line subtle small">Ready to start an experiment</p>
        }
    </div>

    <footer>
        <span class="reports small @(Rig.ReportsStored > 0 ? "has" : "")" title="Issue reports collected from this rig">
            <HubIcon Name="inbox" Size="13" /> @Rig.ReportsStored report@(Rig.ReportsStored == 1 ? "" : "s")
            @if (Rig.ReportsWaiting > 0)
            {
                <span class="waiting-reports" title="Reports waiting on the rig to be collected">@Rig.ReportsWaiting waiting</span>
            }
        </span>
        <button type="button" class="ghost sm token-toggle @(Rig.HasToken ? "set" : "") @(Rig.NeedsToken ? "needed" : "")"
                aria-expanded="@_editingToken" aria-label="Token of @Rig.Id"
                @onclick="() => { _editingToken = !_editingToken; _tokenError = null; }"
                title="@(Rig.HasToken ? "This rig's token is entered in the hub" : "No token entered: needed if the rig has a DAEMON_CLABE_TOKEN")">
            @(Rig.HasToken ? "Token set" : "Token")
        </button>
        <span class="grow"></span>
        @if (!Rig.Reachable)
        {
            <span class="subtle tiny">@(Rig.SeenAt is { } seen ? $"seen {ReportTime.Ago(seen)}" : "never seen")</span>
        }
        else
        {
            <a class="btn sm open" href="@Hub.RigUrl(Rig.Id)" aria-label="Open @Rig.Id">Open <HubIcon Name="right" Size="13" /></a>
        }
        @if (Rig.MovedFrom is null)
        {
            <button type="button" class="ghost icon sm" aria-label="Restart the daemon of @Rig.Id"
                    title="Restart this rig's daemon" aria-expanded="@(_restart is not null)" @onclick="OpenRestart">
                <HubIcon Name="refresh" Size="14" />
            </button>
        }
        <button type="button" class="ghost icon sm" aria-label="Remove @Rig.Id" title="Remove this rig from the hub"
                @onclick="() => { _confirmRemove = true; _removeError = null; }">
            <HubIcon Name="trash" Size="14" />
        </button>
    </footer>
    @if (_confirmRemove)
    {
        <div class="confirm" role="group" aria-label="Remove @Rig.Id">
            <p class="small">Remove <strong>@Rig.Id</strong>? If its daemon still enrolls with this hub, it comes back within minutes, unless you also exclude it.</p>
            <div class="actions">
                <button type="button" class="danger sm" disabled="@_removing" @onclick="() => Remove(exclude: false)">Remove</button>
                <button type="button" class="danger sm" disabled="@_removing" @onclick="() => Remove(exclude: true)">Remove and exclude</button>
                <button type="button" class="ghost sm" disabled="@_removing" @onclick="() => _confirmRemove = false">Cancel</button>
            </div>
        </div>
    }
    @if (_editingToken)
    {
        <form class="token" @onsubmit="SaveToken" @onsubmit:preventDefault>
            <input type="password" autocomplete="off" aria-label="New token of @Rig.Id" @bind="_token" @bind:event="oninput"
                   placeholder="@(Rig.HasToken ? "New token (replaces the one entered)" : "This rig's DAEMON_CLABE_TOKEN")" />
            <button type="submit" class="sm primary" disabled="@(_savingToken || string.IsNullOrWhiteSpace(_token))">Save</button>
            @if (Rig.HasToken)
            {
                <button type="button" class="sm" disabled="@_savingToken" @onclick="ClearToken"
                        title="Delete the token entered for this rig">Clear</button>
            }
        </form>
    }
    @if (_restart == RestartWay.Api)
    {
        <div class="confirm" role="group" aria-label="Restart the daemon of @Rig.Id">
            <p class="small">Restart the daemon of <strong>@Name</strong>? It comes back in a few seconds.</p>
            @if (Rig.Status == "busy")
            {
                <p class="small warn">It runs an experiment: restarting stops it.</p>
            }
            <div class="actions">
                <button type="button" class="primary sm" disabled="@_restarting" @onclick="RestartThroughApi">
                    @(Rig.Status == "busy" ? "Stop the run and restart" : "Restart")
                </button>
                <button type="button" class="sm" disabled="@_restarting" @onclick="() => UseSsh(null)"
                        title="When the daemon hangs: restart it over SSH, with your rig account">Over SSH…</button>
                <button type="button" class="ghost sm" disabled="@_restarting" @onclick="CloseRestart">Cancel</button>
            </div>
        </div>
    }
    else if (_restart == RestartWay.Ssh)
    {
        <form class="confirm ssh" aria-label="Restart the daemon of @Rig.Id over SSH" @onsubmit="RestartOverSsh" @onsubmit:preventDefault>
            <p class="small">
                @(_sshReason ?? "The daemon does not answer.") Restart it over SSH with your rig account: used for
                this restart only, never stored. A run going on the rig is stopped.
            </p>
            <input autocomplete="username" aria-label="Rig username" placeholder="Rig username"
                   title="The rig's logged-on user, or an administrator"
                   @bind="_username" @bind:event="oninput" />
            <input type="password" autocomplete="current-password" aria-label="Rig password" placeholder="Password"
                   @bind="_password" @bind:event="oninput" />
            <div class="actions">
                <button type="submit" class="primary sm"
                        disabled="@(_restarting || string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))">
                    Restart over SSH
                </button>
                <button type="button" class="ghost sm" disabled="@_restarting" @onclick="CloseRestart">Cancel</button>
            </div>
        </form>
    }
    @if (_restartNote is { } note)
    {
        <p class="subtle small card-note" role="status">@note</p>
    }
    @if ((_tokenError ?? _removeError ?? _confirmError ?? _restartError) is { } error)
    {
        <p class="subtle small card-error" role="alert">@error</p>
    }
</article>

@code {
    [Parameter, EditorRequired] public RigStatus Rig { get; set; } = default!;

    /// <summary>Called once the rig is removed or its token changed, e.g. to refresh the fleet.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _editingToken;
    private bool _savingToken;
    private string _token = "";
    private string? _tokenError;

    private bool _confirmRemove;
    private bool _removing;
    private string? _removeError;

    private bool _confirming;
    private string? _confirmError;

    private enum RestartWay { Api, Ssh }
    private RestartWay? _restart;
    private bool _restarting;
    private string? _sshReason;
    private string _username = "";
    private string _password = "";
    private string? _restartNote;
    private string? _restartError;

    private string Name => Rig.RigId ?? Rig.Id;

    /// <summary>Through the daemon's API when it answers; over SSH when it does not.</summary>
    private void OpenRestart()
    {
        if (_restart is not null)
        {
            CloseRestart();
            return;
        }
        (_restartNote, _restartError) = (null, null);
        if (Rig.Reachable && !Rig.NeedsToken)
        {
            _restart = RestartWay.Api;
        }
        else
        {
            UseSsh(Rig.NeedsToken ? "The daemon refuses the hub's token." : null);
        }
    }

    private void UseSsh(string? reason)
    {
        _sshReason = reason;
        _username = Credentials.Username ?? _username;
        _password = Credentials.Password ?? "";
        _restart = RestartWay.Ssh;
    }

    private void CloseRestart()
    {
        _restart = null;
        _password = "";
    }

    private async Task RestartThroughApi()
    {
        _restarting = true;
        _restartError = null;
        try
        {
            await Hub.RestartDaemonAsync(Rig.Id, force: Rig.Status == "busy");
            _restart = null;
            _restartNote = "Restarting: it answers again in a few seconds.";
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException exc)
        {
            UseSsh($"Restarting through its API failed: {exc.Message}.");
        }
        finally
        {
            _restarting = false;
        }
    }

    private async Task RestartOverSsh()
    {
        _restarting = true;
        _restartError = null;
        try
        {
            var revived = await Hub.ReviveAsync(Rig.Id, _username.Trim(), _password);
            (Credentials.Username, Credentials.Password) = (_username.Trim(), _password);
            CloseRestart();
            _restartNote = $"Restarted over SSH (its task: {revived.State})."
                + (revived.FirstConnection ? $" Its SSH host key ({revived.Fingerprint}) is now remembered." : "");
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException exc)
        {
            if (exc.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                Credentials.Forget();
                _password = "";
            }
            _restartError = exc.Message;
        }
        finally
        {
            _restarting = false;
        }
    }

    private async Task Confirm()
    {
        _confirming = true;
        _confirmError = null;
        try
        {
            await Hub.ConfirmAsync(Rig.Id);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException exc)
        {
            _confirmError = exc.Message;
        }
        finally
        {
            _confirming = false;
        }
    }

    private Task SaveToken() => StoreToken(_token.Trim());

    private Task ClearToken() => StoreToken(null);

    private async Task StoreToken(string? token)
    {
        _savingToken = true;
        _tokenError = null;
        try
        {
            await Hub.SetTokenAsync(Rig.Id, token);
            _token = "";
            _editingToken = false;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException exc)
        {
            _tokenError = exc.Message;
        }
        finally
        {
            _savingToken = false;
        }
    }

    private async Task Remove(bool exclude)
    {
        _removing = true;
        _removeError = null;
        try
        {
            if (exclude)
            {
                await Hub.ExcludeAsync(Rig.Id, null);  // excluding removes it too
            }
            else
            {
                await Hub.RemoveAsync(Rig.Id);
            }
            _confirmRemove = false;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException exc)
        {
            _removeError = exc.Message;
        }
        finally
        {
            _removing = false;
        }
    }

    /// <summary>A rig's status chip: its text and its class (waiting pulses).</summary>
    public static (string Text, string Css) StatusChip(RigStatus rig) =>
        rig.MovedFrom is not null ? ("moved", "waiting")
        : rig.NeedsToken ? ("needs token", "waiting")
        : !rig.Reachable ? ("offline", "offline")
        : rig.Waiting is not null ? ("waiting", "waiting")
        : rig.Status switch
        {
            "busy" => ("busy", "running"),
            "leased" => ("leased", "accent"),
            "idle" => ("idle", "idle"),
            var other => (other, ""),
        };

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Authority : url;

    /// <summary>Under the rig id: its hostname, its IP and its clabe; and its name in the hub when that differs.</summary>
    private static string HostLine(RigStatus rig)
    {
        var hostname = rig.Hostname ?? Host(rig.Url);
        var parts = new List<string?> { hostname, rig.Ip, rig.ClabeVersion is { } v ? $"v{v}" : null };
        if (!string.Equals(rig.Id, hostname, StringComparison.OrdinalIgnoreCase))
            parts.Insert(0, rig.Id);
        return string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }
}
