# Copy to .env (next to compose.yml). Rigs enroll themselves: their DAEMON_CLABE_HUBS points at this hub.
# A rig's DAEMON_CLABE_TOKEN is entered on its card in the hub's page.

# The hub's own token (its page and API)
TOKEN=
# The image compose pulls: sha-<commit> (any commit of main, e.g. sha-82d2107), main, or a release (v0.18.0)
# HUB_TAG=main
# PORT=8080
# POLL_INTERVAL=2
# Delete reports collected more than this many days ago (kept forever if unset)
# REPORT_RETENTION_DAYS=90
# REPORT_INTERVAL=5
# LOG_LEVEL=INFO
# ACCESS_LOG=false
