# Copy to .env (next to compose.yml) and fill in. The hub reads these inside its container.

# The hub's own token
TOKEN=change-me
# The rigs' daemon token (their DAEMON_CLABE_TOKEN)
RIG_TOKEN=the-rigs-daemon-token
# The rigs: id=url separated by ";" (or a JSON list of {"id", "url", "token"} for per-rig tokens)
RIGS=rig-3=http://rig-3:8070;rig-4=http://rig-4:8070
# Optional
# PORT=8080
# POLL_INTERVAL=2
