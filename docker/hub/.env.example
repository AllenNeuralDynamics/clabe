# Copy to .env (next to compose.yml). Rigs enroll themselves: their DAEMON_CLABE_HUBS points at this hub.
# A rig's DAEMON_CLABE_TOKEN is entered on its card in the hub's page.

# The hub's own token (its page and API)
TOKEN=
