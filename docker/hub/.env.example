# Copy to .env (next to compose.yml) and fill in. The hub reads these inside its container.

# The rigs: id=url separated by ";" (or a JSON list of {"id", "url", "token"} for per-rig tokens)
RIGS=rig-3=http://rig-3:24070;rig-4=http://rig-4:24070
# Optional: the hub's own token
# TOKEN=
# Optional: the rigs' daemon token (their DAEMON_CLABE_TOKEN), when they have one
# RIG_TOKEN=
# PORT=8080
# POLL_INTERVAL=2
