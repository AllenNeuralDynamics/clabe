# Copy to .env (next to compose.yml). Rigs enroll themselves: their DAEMON_CLABE_HUBS points at this hub.

# What rigs present to enroll (their DAEMON_CLABE_ENROLL_TOKEN). Unset: any rig that reaches the hub can enroll.
ENROLL_TOKEN=
# The hub's own token (its page and API)
# TOKEN=
# The daemon token (DAEMON_CLABE_TOKEN) of rigs without their own; a rig's own token is set on the hub's page
# RIG_TOKEN=
# PORT=8080
# POLL_INTERVAL=2
# Delete reports collected more than this many days ago (kept forever if unset)
# REPORT_RETENTION_DAYS=90
# REPORT_INTERVAL=5
